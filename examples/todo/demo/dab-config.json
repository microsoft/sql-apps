{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v2.0.12/dab.draft.schema.json",
  "data-source": {
    "database-type": "mssql",
    "connection-string": "@env('SQL_CONNECTION_STRING')",
    "options": { "set-session-context": false }
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": false },
    "mcp": { "enabled": false },
    "host": { "mode": "production", "authentication": { "provider": "Unauthenticated" } }
  },
  "entities": {
    "CreateSession": {
      "source": { "object": "dbo.DemoCreateSession", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "GetSession": {
      "source": { "object": "dbo.DemoGetSession", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "DeleteSession": {
      "source": { "object": "dbo.DemoDeleteSession", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "Readiness": {
      "source": { "object": "dbo.DemoReadiness", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "List": {
      "source": { "object": "dbo.DemoTodoList", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "Create": {
      "source": { "object": "dbo.DemoTodoCreate", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "Update": {
      "source": { "object": "dbo.DemoTodoUpdate", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    },
    "Delete": {
      "source": { "object": "dbo.DemoTodoDelete", "type": "stored-procedure" },
      "rest": { "enabled": true, "methods": ["post"] },
      "graphql": { "enabled": false },
      "permissions": [{ "role": "anonymous", "actions": ["execute"] }]
    }
  }
}
