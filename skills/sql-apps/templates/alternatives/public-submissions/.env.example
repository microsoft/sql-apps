# Copy to .env, run local:init, and explicitly accept SQL terms before local:start.
# No identity is required for public submission. Owner access stays disabled.
# Do not add partial AUTH_* values. See references/public-submissions.md for reviewed
# tenant-bound owner configuration and separate operator-only SQL enrollment.
APP_ORIGIN=http://127.0.0.1:5180
APP_HOST=127.0.0.1
APP_PORT=5180
FUNCTIONS_PORT=7071
SQL_PORT=14330
ACCEPT_EULA=N
