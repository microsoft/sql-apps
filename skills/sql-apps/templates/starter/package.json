{
  "name": "sql-apps-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "build": "npm run build:backend && npm run build --workspaces --if-present",
    "build:backend": "tsc -p tsconfig.backend.json",
    "test": "node --test tests/*.test.mjs && npm run test --workspace @app/frontend",
    "local:preflight": "node scripts/development.mjs preflight",
    "local:status": "node scripts/development.mjs status",
    "local:preview": "node scripts/development.mjs preview",
    "local:connect": "node scripts/development.mjs connect",
    "local:ready": "node scripts/development.mjs ready",
    "local:init": "node scripts/local.mjs init",
    "local:start": "node scripts/local.mjs start",
    "local:stop": "node scripts/local.mjs stop",
    "acceptance": "node scripts/acceptance.mjs",
    "deployment:prepare": "node scripts/deployment.mjs",
    "images:build": "node scripts/build-images.mjs",
    "local:adopt-sql": "node scripts/adopt-sql.mjs",
    "start": "npm run local:start",
    "serve:web": "node dist/packages/server/server.js"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "typescript": "5.9.3"
  }
}
