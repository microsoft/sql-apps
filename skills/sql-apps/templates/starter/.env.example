# Copy to .env before local:init. These public identity settings require a reviewed
# external provider. Never put a client secret in a browser application.
AUTH_AUTHORITY=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
AUTH_CLIENT_ID=REPLACE_SPA_CLIENT_ID
AUTH_SCOPE=openid profile api://REPLACE_API_CLIENT_ID/access_as_user
AUTH_ISSUER=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
AUTH_AUDIENCE=REPLACE_API_CLIENT_ID
# Register this exact redirect URI as a SPA redirect in the identity provider.
APP_ORIGIN=http://127.0.0.1:5180
APP_HOST=127.0.0.1
APP_PORT=5180
DAB_PORT=5081
DAB_URL=http://127.0.0.1:5081
# Required explicit acceptance before starting the private-preview SQL engine.
ACCEPT_EULA=N
