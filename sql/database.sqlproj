<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <PropertyGroup>
    <Name>SqlApps</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TreatTSqlWarningsAsErrors>true</TreatTSqlWarningsAsErrors>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="grant-runtime.sql" />
    <Build Remove="local\**\*.sql" />
    <PostDeploy Include="grant-runtime.sql" />
    <SqlCmdVariable Include="DabPrincipalId">
      <DefaultValue>00000000-0000-0000-0000-000000000000</DefaultValue>
      <Value>$(SqlCmdVar__1)</Value>
    </SqlCmdVariable>
    <SqlCmdVariable Include="RoleBasedProcedureGrants">
      <DefaultValue></DefaultValue>
      <Value>$(SqlCmdVar__2)</Value>
    </SqlCmdVariable>
  </ItemGroup>
  <Target Name="ExtractApplicationModel" AfterTargets="Build">
    <Unzip SourceFiles="$(SqlTargetPath)" DestinationFolder="$(IntermediateOutputPath)model" />
  </Target>
</Project>